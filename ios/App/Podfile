platform :ios, '15.0'
use_frameworks!

target 'App' do
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../node_modules/@revenuecat/purchases-capacitor'
  # Firebase Analytics is a hand-written native plugin (see
  # ios/App/App/FirebaseAnalyticsPlugin.swift) calling these SDKs directly,
  # not @capacitor-firebase/analytics — that npm package's podspec makes
  # CocoaPods generate it as a dependency-only aggregate target with no
  # build phases, so its own plugin source is never compiled (confirmed
  # across two package versions by inspecting the generated Pods.xcodeproj).
  # Core subspec, not Default/IdentitySupport: gives real event/session
  # tracking without pulling in the IDFA-collecting IdentitySupport
  # subspec, which would need an App Tracking Transparency prompt we have
  # no other reason to add.
  pod 'FirebaseAnalytics/Core', '~> 12.17.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
