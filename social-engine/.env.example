# ---- Database og kø ----
DATABASE_URL=postgres://postgres@127.0.0.1:5432/social_engine
REDIS_URL=redis://127.0.0.1:6379

# ---- Drift ----
# Dry-run er default ved første oppstart. Hele pipelinen kjører og
# lagrer resultatet med reelle kostnadstall, men ingenting publiseres.
DRY_RUN=true

# Global kill switch. false = ingenting publiseres, alt køes.
SYSTEM_ENABLED=false

LOG_LEVEL=info
TZ=Europe/Oslo

# ---- Valuta ----
# Fallback når kurs-API ikke svarer. Revenue-agenten henter live kurs.
FX_USD_NOK=9.30

# ---- API-nøkler (fylles ut i .env, ALDRI i git) ----
# TODO(kristian): fyll inn når vi kommer til Fase 2 og 3
ANTHROPIC_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
