rules_version = '2';

// Together (com.kricliff.together) — Firestore security rules for the
// Community feature and cloud backup. Not deployed automatically from this
// repo (no firebase.json/Firebase CLI wiring here) — paste into Firebase
// Console → Firestore Database → Rules and publish.
//
// This is the live ruleset (as pasted in by the user) with the gaps found
// in the 2026-08-03 security review closed:
//   - `update` previously allowed a signed-in user to set support/
//     beenThere/reports/replyCount to ANY value, just restricted to those
//     field names. A client could jump `reports` straight past
//     REPORT_HIDE_THRESHOLD (3, see www/index.html) to instantly censor
//     any post. Now every counter change must be exactly +1 (or -1 for the
//     toggleable support/beenThere reactions) per write.
//   - `create` on posts/replies didn't validate the document ID shape.
//     Firestore's own auto-IDs (collection.add()) are always 20
//     alphanumeric characters; the app's rendering code interpolates that
//     ID into onclick="..." handlers (now also escaped client-side, but
//     this is the belt-and-suspenders fix at the source) — rejecting any
//     other ID shape at write time closes that stored-XSS vector even for
//     clients that bypass the app UI entirely.
//   - `create` didn't validate field types/sizes or that counters start
//     at 0, so a malicious client could publish a post/reply with an
//     already-inflated reports count, an oversized text blob, etc.
//   - `reports` create didn't tie the document ID or `reporter` field to
//     the caller's own uid, so a client could file reports as/about
//     arbitrary users or spam multiple report docs for the same post
//     (the app's deterministic `postId_uid` doc ID convention was only a
//     client-side convention, not enforced).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Firestore auto-IDs (collection.add()) are always exactly 20 chars
    // from this alphabet.
    function isAutoId(id) {
      return id.matches('^[A-Za-z0-9]{20}$');
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // +1 only (reports, replyCount: monotonically increasing counters).
    function isBoundedIncrement(field) {
      return onlyChangedFields([field])
        && request.resource.data[field] == resource.data[field] + 1;
    }

    // +1 or -1 (support, beenThere: user can toggle a reaction on/off).
    function isBoundedToggle(field) {
      return onlyChangedFields([field])
        && (request.resource.data[field] == resource.data[field] + 1
            || request.resource.data[field] == resource.data[field] - 1);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && isAutoId(postId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.who is string && request.resource.data.who.size() <= 24
                    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
                    && request.resource.data.support == 0
                    && request.resource.data.beenThere == 0
                    && request.resource.data.reports == 0
                    && request.resource.data.replyCount == 0;

      // any signed-in user may bump support / been-there / reports / replyCount counters,
      // but only ONE of those fields per write, and only by the bounded step above -
      // text and author can never be edited, and no counter can be set to an
      // arbitrary value in one write.
      allow update: if isSignedIn() && (
        isBoundedToggle('support') ||
        isBoundedToggle('beenThere') ||
        isBoundedIncrement('reports') ||
        isBoundedIncrement('replyCount')
      );

      // only the author can delete their own post
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && isAutoId(replyId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.who is string && request.resource.data.who.size() <= 24
                      && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      // Doc ID must be `${postId}_${reporterUid}` (matches the app's own
      // convention) and `reporter` must be the caller - ties every report
      // to exactly one post and one self-attested reporter, and doubles as
      // "one report per user per post" since the ID is deterministic.
      allow create: if isSignedIn()
                    && reportId == request.resource.data.postId + '_' + request.auth.uid
                    && request.resource.data.reporter == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /backups/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
